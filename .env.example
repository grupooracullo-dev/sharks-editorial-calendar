# Sharks Editorial Calendar — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it's gitignored).

# ==========================================
# Supabase (REQUIRED)
# ==========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ==========================================
# Notes
# ==========================================
# - VITE_ prefix is required for variables to be inlined into the build.
# - All VITE_* vars are PUBLIC — anyone can read them in the browser.
# - Secret keys (service role, worker secret, OAuth secrets) belong ONLY
#   on the Supabase side (Edge Functions secrets, never the frontend).
