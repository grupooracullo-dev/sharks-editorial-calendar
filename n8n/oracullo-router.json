{
  "name": "Oracullo Prospecting Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "oracullo-prospecting",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook Oracullo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "oracullo-prospecting"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-worker-secret'] }}",
              "rightValue": "={{ $env.WORKER_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Secret OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "enrich_company",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "enrich_company"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Tipo de Job",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://brasilapi.com.br/api/cnpj/v1/{{ $json.body.input.cnpj }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "BrasilAPI CNPJ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 180],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst webhook = $('Webhook Oracullo').first().json;\nconst jobId = webhook.body.job_id;\nconst campanha = webhook.body.campaign_id;\n\nif (item.error || !item.cnpj) {\n  return {\n    json: {\n      job_id: jobId,\n      status: 'failed',\n      error: 'CNPJ invalido ou BrasilAPI indisponivel'\n    }\n  };\n}\n\nreturn {\n  json: {\n    job_id: jobId,\n    status: 'completed',\n    output: {\n      cnpj: item.cnpj,\n      razao_social: item.razao_social ?? null,\n      municipio: item.municipio ?? null,\n      uf: item.uf ?? null,\n      ddd_telefone: item.ddd_telefone_1 ?? null,\n      cnae_descricao: item.cnae_fiscal_descricao ?? null,\n      situacao: item.descricao_situacao_cadastral ?? null,\n      data_situacao: item.data_situacao_cadastral ?? null,\n      capital_social: item.capital_social ?? null,\n      _campaign_id: campanha\n    }\n  }\n};"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Normalizar Enriquecimento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ORACULLO_EDGE_URL }}/functions/v1/prospecting-job-callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-worker-secret", "value": "={{ $env.WORKER_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Callback Enriquecimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 180]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const webhook = $('Webhook Oracullo').first().json;\nreturn {\n  json: {\n    job_id: webhook.body.job_id,\n    status: 'failed',\n    error: `Tipo ${webhook.body.type} ainda nao suportado no n8n (F4)`\n  }\n};"
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Não suportado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ORACULLO_EDGE_URL }}/functions/v1/prospecting-job-callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-worker-secret", "value": "={{ $env.WORKER_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Callback Padrão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 460]
    }
  ],
  "connections": {
    "Webhook Oracullo": {
      "main": [[{ "node": "Secret OK?", "type": "main", "index": 0 }]]
    },
    "Secret OK?": {
      "main": [
        [{ "node": "Tipo de Job", "type": "main", "index": 0 }],
        []
      ]
    },
    "Tipo de Job": {
      "main": [
        [{ "node": "BrasilAPI CNPJ", "type": "main", "index": 0 }],
        [{ "node": "Não suportado", "type": "main", "index": 0 }]
      ]
    },
    "BrasilAPI CNPJ": {
      "main": [[{ "node": "Normalizar Enriquecimento", "type": "main", "index": 0 }]]
    },
    "Normalizar Enriquecimento": {
      "main": [[{ "node": "Callback Enriquecimento", "type": "main", "index": 0 }]]
    },
    "Não suportado": {
      "main": [[{ "node": "Callback Padrão", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
