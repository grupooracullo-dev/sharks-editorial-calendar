                      "id":  "b1000000-0006-4000-8000-000000000006",
                      "name":  "Callback Enriquecimento",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       1100,
                                       140
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "// Prepara o envio: audio (audio_url) ou texto em blocos de 150 caracteres\nconst webhook = $(\u0027Webhook Oracullo\u0027).first().json;\nconst input = webhook.body.input ?? {};\nconst msg = String(input.message ?? \u0027\u0027);\nconst base = { job_id: webhook.body.job_id, channel: input.channel ?? \u0027whatsapp\u0027, to: input.to ?? \u0027\u0027 };\nif (input.audio_url) {\n  try {\n    const res = await fetch(String(input.audio_url));\n    if (res.ok) {\n      const buf = Buffer.from(await res.arrayBuffer());\n      return [{ json: { ...base, mode: \u0027audio\u0027, audio: \u0027data:audio/mpeg;base64,\u0027 + buf.toString(\u0027base64\u0027), text: msg, part: 1, total: 1 } }];\n    }\n  } catch (e) { /* fallback: envia texto */ }\n}\nconst chunks = [];\nfor (let i = 0; i \u003c msg.length; i += 150) chunks.push(msg.slice(i, i + 150));\nreturn chunks.map((text, i) =\u003e ({ json: { ...base, mode: \u0027text\u0027, text, part: i + 1, total: chunks.length } }));"
                                     },
