                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "const item = $input.item.json;\nconst webhook = $(\u0027Webhook Oracullo\u0027).first().json;\nif (item.error || !item.cnpj) {\n  return { json: { job_id: webhook.body.job_id, status: \u0027failed\u0027, error: \u0027CNPJ invalido ou BrasilAPI indisponivel\u0027 } };\n}\nreturn { json: {\n  job_id: webhook.body.job_id,\n  status: \u0027completed\u0027,\n  output: {\n    cnpj: item.cnpj,\n    razao_social: item.razao_social ?? null,\n    municipio: item.municipio ?? null,\n    uf: item.uf ?? null,\n    ddd_telefone: item.ddd_telefone_1 ?? null,\n    cnae_descricao: item.cnae_fiscal_descricao ?? null,\n    situacao: item.descricao_situacao_cadastral ?? null,\n    capital_social: item.capital_social ?? null\n  }\n} };"
